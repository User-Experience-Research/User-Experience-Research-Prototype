# Server-side secret. Add a real value only in your shell or hosting dashboard.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# External production database. Use a direct Neon connection string so Flyway can migrate it.
DATABASE_URL=
# Only needed when DATABASE_URL is a credential-free JDBC URL.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=3

# Use a long random value in production.
SESSION_SECRET=
COOKIE_SECURE=false
