<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pageTitle }} | NMSI Student Portal</title>
    <link rel="stylesheet" href="/assets/css/app.css">
    <script src="/assets/js/accessibility.js" defer></script>
    <script src="/assets/js/portal-navigation.js" defer></script>
</head>
<body class="portal-page">
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="portal-shell">
    <aside id="portal-sidebar" class="portal-sidebar" aria-label="Student portal" tabindex="-1">
        <div class="sidebar-topbar">
            <a class="portal-brand" href="/dashboard" aria-label="NMSI student portal home">
                <span class="sidebar-wordmark">NMSI</span>
                <span class="sidebar-institute">North-western Medical and Science Institute</span>
            </a>
            <button
                class="sidebar-close"
                type="button"
                data-sidebar-close
                aria-label="Close student portal menu"
            >
                <span aria-hidden="true">←</span>
            </button>
        </div>
        <div class="student-profile">
            <span class="student-avatar" aria-hidden="true">JD</span>
            <span>
                <strong>{{ session.displayName }}</strong>
                <small>Student account</small>
            </span>
        </div>
        <nav aria-label="Primary">
            <a href="/dashboard" {% if activePage == "dashboard" %}aria-current="page"{% endif %}>
                <span class="nav-icon" aria-hidden="true">H</span>
                <span>Home</span>
            </a>
            <a href="/support" {% if activePage == "support" %}aria-current="page"{% endif %}>
                <span class="nav-icon" aria-hidden="true">?</span>
                <span>Support Navigator</span>
            </a>
            <a href="/appointments" {% if activePage == "appointments" %}aria-current="page"{% endif %}>
                <span class="nav-icon" aria-hidden="true">A</span>
                <span>My appointments</span>
            </a>
            <a href="#" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">M</span>
                <span>Messages</span>
            </a>
            <a href="#" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">C</span>
                <span>Course area</span>
            </a>
        </nav>
        <div class="sidebar-footer">
            <form class="logout-form" method="post" action="/logout">
                <button class="sidebar-action" type="submit">
                    <span aria-hidden="true">↪</span>
                    <span>Sign out</span>
                </button>
            </form>
            <p><a href="#">Privacy</a> · <a href="#">Terms</a> · <a href="#">Accessibility</a></p>
        </div>
    </aside>
    <button
        class="sidebar-backdrop"
        type="button"
        data-sidebar-close
        aria-label="Close student portal menu"
        tabindex="-1"
    ></button>
    <div class="portal-workspace" data-portal-workspace>
        <header class="portal-header">
            <button
                class="mobile-menu-toggle"
                type="button"
                data-sidebar-open
                aria-controls="portal-sidebar"
                aria-expanded="false"
                aria-label="Open student portal menu"
            >
                <span aria-hidden="true">☰</span>
            </button>
            <div class="portal-title-group">
                <p class="portal-title">Student portal</p>
                <p class="institution-name">North-western Medical and Science Institute</p>
            </div>
            <p class="mobile-page-title">{{ pageTitle }}</p>
            <button class="font-toggle font-toggle--header" type="button" data-font-toggle aria-pressed="false">Large font: Off</button>
        </header>
        <div class="portal-hero" aria-hidden="true">
            <span class="nmsi-logo nmsi-logo--hero">
                <span>N</span><span>M</span><span>S</span><span>I</span>
            </span>
        </div>
        <main id="main-content" class="portal-main">
