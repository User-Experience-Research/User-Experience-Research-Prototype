<button
    id="support-chat-launcher"
    class="chat-launcher"
    type="button"
    aria-controls="support-chat-panel"
    aria-expanded="false"
>
    <span class="chat-launcher__icon" aria-hidden="true">✦</span>
    <span>Ask Support Guide</span>
</button>

<section
    id="support-chat-panel"
    class="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="support-chat-title"
    hidden
>
    <header class="chat-header">
        <div>
            <p class="eyebrow">Immediate guidance</p>
            <h2 id="support-chat-title">Support Guide</h2>
        </div>
        <button id="support-chat-close" class="chat-close" type="button" aria-label="Close Support Guide">×</button>
    </header>
    <p class="chat-scope">
        Describe what is happening in your own words. This guide offers initial routing, not a medical diagnosis or emergency service.
    </p>
    <div id="support-chat-log" class="chat-log" role="log" aria-live="polite" aria-relevant="additions">
        <div class="chat-message chat-message--assistant">
            <p>Hi, how can I help you today?</p>
        </div>
    </div>
    <div class="chat-suggestions" aria-label="Example questions">
        <button type="button" data-chat-suggestion="I am stressed about a deadline and I am not sure who to ask.">
            <span aria-hidden="true">⌁</span>
            <span>Deadline stress</span>
        </button>
        <button type="button" data-chat-suggestion="My laptop cannot connect to the university Wi-Fi.">
            <span aria-hidden="true">⌘</span>
            <span>Digital access</span>
        </button>
        <button type="button" data-chat-suggestion="Can you show me my appointments?">
            <span aria-hidden="true">▣</span>
            <span>My appointments</span>
        </button>
    </div>
    <form id="support-chat-form" class="chat-form">
        <label for="support-chat-input">Your message</label>
        <div>
            <textarea
                id="support-chat-input"
                name="message"
                rows="2"
                maxlength="1200"
                required
                placeholder="Describe your situation"
            ></textarea>
            <button class="chat-send" type="submit">
                <span>Send</span>
                <span aria-hidden="true">↑</span>
            </button>
        </div>
        <p id="support-chat-status" class="chat-status" role="status" aria-live="polite"></p>
    </form>
</section>
