{% include "fragments/portal-start" %}
<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/support">Support Navigator</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ facility.name }}</span>
</nav>

<header class="page-heading facility-heading">
    <div class="tag-row">
        {% for category in facility.categories %}
            <span class="tag">{{ category.name }}</span>
        {% endfor %}
    </div>
    <h1>{{ facility.name }}</h1>
    <p>{{ facility.summary }}</p>
</header>

<div class="detail-layout">
    <section class="detail-card" aria-labelledby="compare-heading">
        <h2 id="compare-heading">What to know before you choose</h2>
        <dl class="detail-list">
            <div><dt>Provider</dt><dd>{{ facility.provider }}</dd></div>
            <div><dt>Location and distance</dt><dd>{{ facility.location }} · about {{ facility.distanceMinutes }} minutes</dd></div>
            <div><dt>Response time</dt><dd>{{ facility.responseTime }}</dd></div>
            <div><dt>How to access</dt><dd>{{ facility.contactMode }}</dd></div>
            <div><dt>Who can use it</dt><dd>{{ facility.eligibility }}</dd></div>
            <div><dt>What to prepare</dt><dd>{{ facility.preparation }}</dd></div>
            <div><dt>Student rating</dt><dd>{{ facility.rating }} out of 5</dd></div>
        </dl>
    </section>

    <section class="booking-card" aria-labelledby="booking-heading">
        <p class="eyebrow">Optional next step</p>
        <h2 id="booking-heading">Book a demonstration appointment</h2>
        <p id="booking-help">Choose a date first, then select one of its available future times.</p>
        <form method="post" action="/appointments" data-appointment-booking>
            <input type="hidden" name="facilityId" value="{{ facility.id }}">
            <div class="booking-field-grid">
                <div>
                    <label for="appointment-date">Date</label>
                    <input
                        id="appointment-date"
                        name="appointmentDate"
                        type="date"
                        min="{{ bookingToday }}"
                        aria-describedby="booking-help appointment-availability"
                        required
                    >
                </div>
                <div>
                    <label for="starts-at">Time</label>
                    <select
                        id="starts-at"
                        name="startsAt"
                        aria-describedby="booking-help appointment-availability"
                        required
                        disabled
                    >
                        <option value="">Choose a date first</option>
                        {% for slot in availableSlots %}
                            <option
                                value="{{ slot.startsAt }}"
                                data-appointment-slot
                                data-date="{{ slot.dateValue }}"
                                data-starts-at="{{ slot.startsAt }}"
                                disabled
                                hidden
                            >{{ slot.timeLabel }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <p id="appointment-availability" class="availability-status" role="status" aria-live="polite">
                Select a date to see available times.
            </p>
            <label for="appointment-note">Anything useful to share? <span>(optional)</span></label>
            <textarea id="appointment-note" name="note" rows="4" maxlength="500"></textarea>
            <button class="button-with-icon" type="submit" disabled>
                <span aria-hidden="true">＋</span>
                <span>Book appointment</span>
            </button>
        </form>
    </section>
</div>
<script src="/assets/js/appointment-booking.js" defer></script>
{% include "fragments/portal-end" %}
