{% include "fragments/portal-start" %}
<header class="page-heading">
    <p class="eyebrow">Home</p>
    <h1>Student services</h1>
    <p>Open a student service or continue with a support request.</p>
</header>

<section class="service-section" aria-labelledby="student-support-heading">
    <h2 id="student-support-heading">Support and student systems</h2>
    <div class="service-directory">
        <div class="directory-visual">
            <span class="directory-visual__icon" aria-hidden="true">＋</span>
            <div>
                <p class="eyebrow">Recommended route</p>
                <h3>Start with what is happening</h3>
                <p>Search across services, compare practical details and choose a next step.</p>
            </div>
        </div>
        <div class="directory-links">
            <a class="directory-link directory-link--featured" href="/support">
                <span class="directory-link__icon" aria-hidden="true">⌕</span>
                <span>
                    <strong>Student Support Navigator</strong>
                    <small>Describe a concern and compare overlapping support sources</small>
                </span>
                <span class="directory-link__arrow" aria-hidden="true">→</span>
            </a>
            <a class="directory-link" href="/appointments">
                <span class="directory-link__icon" aria-hidden="true">▣</span>
                <span>
                    <strong>My appointments</strong>
                    <small>{{ appointments | length }} active support appointment(s)</small>
                </span>
                <span class="directory-link__arrow" aria-hidden="true">→</span>
            </a>
            <div class="directory-link directory-link--disabled">
                <span class="directory-link__icon" aria-hidden="true">▤</span>
                <span>
                    <strong>Learning materials</strong>
                    <small>Courses and assessments</small>
                </span>
            </div>
            <div class="directory-link directory-link--disabled">
                <span class="directory-link__icon" aria-hidden="true">◷</span>
                <span>
                    <strong>My timetable</strong>
                    <small>Teaching schedule</small>
                </span>
            </div>
        </div>
    </div>
</section>

<section class="service-section" aria-labelledby="tools-heading">
    <h2 id="tools-heading">Before you choose a support source</h2>
    <div class="guidance-strip">
        <p><strong>Compare more than the title.</strong> Scope, provider, response time, access mode and location can help separate services that sound similar.</p>
        <a class="text-action" href="/support">
            <span>Browse the support directory</span>
            <span aria-hidden="true">→</span>
        </a>
    </div>
</section>
{% include "fragments/portal-end" %}
